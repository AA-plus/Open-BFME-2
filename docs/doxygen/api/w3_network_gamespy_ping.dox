/// \ingroup grp_w3_network_gamespy_ping
/// \brief The room-key wrapper around the GameSpy chat SDK,
///        dispatchIndexedValue.
///
/// \see dispatchIndexedValue

/// \file Thread/GetNickForMessage.cpp
/// \ingroup grp_w3_network_gamespy_ping
/// \brief The GameSpy Presence nickname callback for buddy messages,
///        getNickForMessage.
///
/// \see getNickForMessage
