/// \brief GetGameLogicRandomValue, the logic stream's integer draw.
///
/// One of the small files the reconstruction splits the original
/// RandomValue.cpp into; \ref grp_w3_random_values describes the whole
/// family.

/// \file Common/GameLogicRandomValue_getValueReal.cpp
/// \ingroup grp_w3_random_values
/// \brief GetGameLogicRandomValueReal, the logic stream's Real draw.
///
/// One of the small files the reconstruction splits the original
/// RandomValue.cpp into; \ref grp_w3_random_values describes the whole
/// family.

