#!/bin/sh
# Run a tool under Python 3: `sh .githooks/run-python3 tools/x.py ARGS`.
# The merge driver (tools/setup_hooks.sh) runs with no hook around it. Where
# `python3` is the Microsoft Store shortcut (exit 9009), a bare
# `python3 tools/merge_rows.py` fails and git leaves every union ledger of a
# pull conflicted; `py -3` is the launcher python.org installs on Windows.
probe="import sys; sys.exit(sys.version_info[0] != 3)"
python3 -c "$probe" >/dev/null 2>&1 && exec python3 "$@"
py -3 -c "$probe" >/dev/null 2>&1 && exec py -3 "$@"
echo "run-python3: no working Python 3 (neither python3 nor py -3) to run $1;" \
     "the merge is left conflicted. Install Python 3 from python.org and retry." >&2
exit 1
